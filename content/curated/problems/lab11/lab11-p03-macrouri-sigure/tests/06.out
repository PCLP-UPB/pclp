ARRAY_LEN(prime) = 6
a=1 b=100 c=50
  SQR(a + 1) = 4
  SQR(c) % 7 = 1
  MAX(a, b) * 2 = 200
  MIN(a - b, c) = -99
  ABS(a - b) = 99
  CLAMP(c, a, b) = 50
  IN_RANGE(c, a, b) = 1
  !IN_RANGE(c, a, b) = 0
  10 - MAX(a, c) = -40
a=5 b=1 c=3
