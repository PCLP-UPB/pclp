TEST_TIMEOUT = 2.0
VALGRIND_TIMEOUT = 30.0
SHOW_LINES = 20


def norm_output(s: str) -> str:
    lines = [ln.rstrip() for ln in s.replace("\r\n", "\n").split("\n")]
    while lines and not lines[-1]:
        lines.pop()
    return "\n".join(lines)


def find_problem(pid: str | None) -> tuple[str, Path]:
    cwd = Path.cwd().resolve()
    if not pid:
        # cel mai apropiat director părinte aflat direct sub sapt-NN/
        for d in [cwd, *cwd.parents]:
            if re.fullmatch(r"sapt-\d\d", d.parent.name):
                return d.name, d
        return cwd.name, cwd
    cands = sorted(WORK.glob(f"sapt-*/{pid}"))
    if cands:
        return pid, cands[-1]
    if cwd.name == pid:
        return pid, cwd
    return pid, cwd


def read_text(p: Path, limit=None) -> str:
    try:
        t = p.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    return t if limit is None else t[:limit]


def clip(s: str, max_chars=10000) -> str:
    return s if len(s) <= max_chars else s[:max_chars] + f"\n[... {len(s) - max_chars} caractere omise]"


def clip_lines(s: str, n=SHOW_LINES) -> str:
    lines = s.split("\n")
    if len(lines) <= n:
        return s
    return "\n".join(lines[:n]) + f"\n[... încă {len(lines) - n} linii]"


def run_tests(pid: str, pdir: Path, use_valgrind: bool) -> dict:
    tdir = CONTENT / "problems" / pid / "tests"
    res = {"problem": pid, "problem_dir": str(pdir), "compiled": False, "compile_output": "",
           "tests": [], "passed": 0, "total": 0, "valgrind": use_valgrind, "error": None}
    if not tdir.is_dir():
        res["error"] = f"nu există teste pentru problema „{pid}” ({tdir})"
        return res
    sources = sorted(p.name for p in pdir.glob("*.c"))
    if not sources:
        res["error"] = f"nu există fișiere .c în {pdir}"
        return res
    tmp = Path(tempfile.mkdtemp(prefix="pclp-test-"))
    try:
        exe = tmp / "main"
        cc = subprocess.run(["gcc", "-Wall", "-Wextra", "-std=c11", "-g", "-o", str(exe), *sources, "-lm"],
                            cwd=pdir, capture_output=True, text=True)
        res["compile_output"] = clip(cc.stdout + cc.stderr)
        res["compiled"] = cc.returncode == 0 and exe.exists()
        if not res["compiled"]:
            return res
        names = sorted({p.stem for p in tdir.glob("*.in")} | {p.stem for p in tdir.glob("*.out")},
                       key=lambda x: (len(x), x))
        for name in names:
            fin, fout = tdir / f"{name}.in", tdir / f"{name}.out"
            if not fout.exists():
                continue
            stdin = read_text(fin) if fin.exists() else ""
            expected = read_text(fout)
            args = [ln for ln in read_text(tdir / f"{name}.args").splitlines() if ln.strip()] \
                if (tdir / f"{name}.args").exists() else []
            rdir = tmp / f"run-{name}"
            if (tdir / f"{name}.files").is_dir():
                shutil.copytree(tdir / f"{name}.files", rdir)
            else:
                rdir.mkdir()
            t = {"name": name, "ok": False, "timeout": False, "expected": clip(expected), "got": "",
                 "stdin": clip(stdin), "args": args, "exit_code": None, "stderr": ""}
            cmd = [str(exe), *args]
            limit = TEST_TIMEOUT
            if use_valgrind:
                vlog = tmp / f"valgrind-{name}.txt"
                cmd = ["/usr/bin/valgrind", "--leak-check=full", "--error-exitcode=99", "-q",
                       f"--log-file={vlog}", *cmd]
                limit = VALGRIND_TIMEOUT
            try:
                r = subprocess.run(cmd, cwd=rdir, input=stdin.encode(), capture_output=True, timeout=limit)
                t["got"] = clip(r.stdout.decode("utf-8", "replace"))
                t["stderr"] = clip(r.stderr.decode("utf-8", "replace"), 4000)
                t["exit_code"] = r.returncode
                t["ok"] = norm_output(r.stdout.decode("utf-8", "replace")) == norm_output(expected)
            except subprocess.TimeoutExpired as e:
                t["timeout"] = True
                t["got"] = clip((e.stdout or b"").decode("utf-8", "replace"))
            if use_valgrind:
                vtext = read_text(tmp / f"valgrind-{name}.txt")
                t["valgrind_output"] = clip(vtext, 6000)
                t["valgrind_ok"] = not t["timeout"] and t["exit_code"] != 99 and not vtext.strip()
                t["ok"] = t["ok"] and t["valgrind_ok"]
            res["tests"].append(t)
        res["total"] = len(res["tests"])
        res["passed"] = sum(1 for t in res["tests"] if t["ok"])
        return res
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def log_test_run(res: dict):
    if not PDIR.is_dir():
        return
    line = "\t".join([now_iso(), res["problem"], f"{res['passed']}/{res['total']}",
                      "compile_ok" if res["compiled"] else "compile_fail",
                      "valgrind" if res.get("valgrind") else "normal"])
    try:
        with open(PDIR / "tests.log", "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def cmd_test(a):
    pid, pdir = find_problem(a.problem)
    res = run_tests(pid, pdir, a.valgrind)
    if res["error"] is None:
        log_test_run(res)
    if a.json:
        print(json.dumps(res, ensure_ascii=False, indent=1))
        sys.exit(0 if res["compiled"] and res["total"] and res["passed"] == res["total"] else 1)
    if res["error"]:
        die(res["error"])
    print(f"Problema {pid}  ({host_path(pdir)})")
    if not res["compiled"]:
        print(res["compile_output"].rstrip())
        print("✘ Compilarea a eșuat — corectează erorile de mai sus.")
        sys.exit(1)
    if res["compile_output"].strip():
        print(res["compile_output"].rstrip())
        print("(compilat, dar cu avertismente — merită citite!)")
    for t in res["tests"]:
        if t["ok"]:
            print(f"  ✔ test {t['name']}")
            continue
        why = "depășire de timp" if t["timeout"] else "rezultat greșit"
        if a.valgrind and not t.get("valgrind_ok", True) and not t["timeout"]:
            why = "erori de memorie (valgrind)" if norm_output(t["got"]) == norm_output(t["expected"]) \
                else "rezultat greșit + erori de memorie"
        print(f"  ✘ test {t['name']} — {why}")
        if t["args"]:
            print("    argumente: " + " ".join(t["args"]))
        same = not t["timeout"] and norm_output(t["got"]) == norm_output(t["expected"])
        for label, key in (() if same else (("intrare", "stdin"), ("așteptat", "expected"), ("obținut", "got"))):
            print(f"    --- {label} ---")
            print("    " + clip_lines(t[key].rstrip("\n")).replace("\n", "\n    "))
        if t.get("stderr", "").strip():
            print("    --- stderr ---\n    " + clip_lines(t["stderr"].rstrip()).replace("\n", "\n    "))
        if a.valgrind and t.get("valgrind_output", "").strip():
            print("    --- valgrind ---\n    " + clip_lines(t["valgrind_output"].rstrip(), 30).replace("\n", "\n    "))
    ok = res["total"] > 0 and res["passed"] == res["total"]
    print(f"{'✔' if ok else '✘'} {res['passed']}/{res['total']} teste trecute"
          + (" (cu valgrind)" if a.valgrind else ""))
    sys.exit(0 if ok else 1)


