def cmd_ai_install(a):
    pkg, binname = AI_PACKAGES[a.tool]
    prefix = os.environ.get("NPM_CONFIG_PREFIX", str(HOME / ".npm-global"))
    Path(prefix).mkdir(parents=True, exist_ok=True)
    print(f"Instalez {pkg} în {prefix} ...")
    r = subprocess.run(["npm", "install", "-g", "--no-fund", "--no-audit", pkg],
                       env={**os.environ, "NPM_CONFIG_PREFIX": prefix})
    if r.returncode != 0:
        die(f"instalarea {pkg} a eșuat (cod {r.returncode})", r.returncode)
    print(f"""
Gata. Pornește-l dintr-un terminal, în directorul problemei:  {binname}
 - Autentificarea/cheia ta rămâne DOAR pe calculatorul tău (work/.pclp/state/, nu intră în predare).
 - Conversațiile (prompturile și răspunsurile) sunt copiate automat în work/.pclp/ai/{a.tool}/
   și fac parte din istoricul predat — asta e intenționat: se evaluează procesul.
 - În ~/work există AGENTS.md / CLAUDE.md / GEMINI.md: asistentul e rugat să se poarte ca un tutore.""")


