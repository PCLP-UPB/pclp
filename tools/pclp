def write_if_missing(path: Path, content: str | bytes):
    if path.exists():
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    if isinstance(content, bytes):
        path.write_bytes(content)
    else:
        path.write_text(content, encoding="utf-8")
    return True


def template(name: str, default: str = "") -> str:
    p = TEMPLATES / name
    try:
        return p.read_text(encoding="utf-8")
    except OSError:
        return default


def ask(prompt: str, default: str = "", validate=None) -> str:
    while True:
        v = input(f"{prompt}{f' [{default}]' if default else ''}: ").strip() or default
        if not v:
            print("  Câmp obligatoriu.")
            continue
        if validate and not validate(v):
            continue
        return v


def valid_email(v):
    ok = bool(re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", v))
    if not ok:
        print("  Adresă de email invalidă.")
    return ok


def valid_group(v):
    ok = bool(re.fullmatch(r"[0-9]{3}[A-Za-z]{1,3}", v))
    if not ok:
        print("  Grupa are forma 311CA (3 cifre + seria).")
    return ok


def apply_identity(st: dict):
    name = st.get("name") or "Student PCLP"
    email = st.get("email") or "student@pclp.invalid"
    git("config", "user.name", name)
    git("config", "user.email", email)


def cmd_init(a):
    WORK.mkdir(parents=True, exist_ok=True)
    for d in (PDIR, AIDIR, AIDIR / "external", STATE):
        d.mkdir(parents=True, exist_ok=True)
    new_repo = not (WORK / ".git").is_dir()
    if new_repo:
        git("init", "-q", "-b", "main")

    # fișiere de bază (nu suprascriem ce există)
    write_if_missing(WORK / ".gitignore", template("work/gitignore", "*\n!*/\n!*.c\n!*.h\n"))
    write_if_missing(WORK / ".clang-format", template("work/.clang-format"))
    write_if_missing(WORK / "compile_flags.txt", template("work/compile_flags.txt", "-xc\n-Wall\n-Wextra\n"))
    for f in ("tasks.json", "launch.json"):  # VS Code citește .vscode/ doar din rădăcina workspace-ului
        write_if_missing(WORK / ".vscode" / f, template(f"vscode/{f}"))
    tutor = template("work/tutor.md", "# Tutore PCLP\n")
    write_if_missing(WORK / "AGENTS.md", tutor)
    write_if_missing(WORK / "CLAUDE.md", tutor)
    write_if_missing(WORK / "GEMINI.md", tutor)
    write_if_missing(WORK / ".continue" / "rules" / "tutor.md",
                     "---\nname: Tutore PCLP\nalwaysApply: true\n"
                     "description: Asistentul se comportă ca un tutore pentru un student din anul I\n---\n\n"
                     + tutor)
    for f in ("terminal.log", "tools.log", "tests.log"):
        (PDIR / f).touch(exist_ok=True)

    st = load_student()
    changed = False
    fields = {"name": a.name, "email": a.email, "group": a.group}
    if any(fields.values()):
        for k, v in fields.items():
            if v:
                st[k] = v.strip()
                changed = True
    elif not a.auto and sys.stdin.isatty():
        print("Configurare PCLP — datele apar în predările tale (trebuie să fie cele din Moodle).")
        st["name"] = ask("Nume complet (ca în Moodle)", st.get("name", ""))
        st["email"] = ask("Email Moodle", st.get("email", ""), valid_email)
        st["group"] = ask("Grupa (ex. 311CA)", st.get("group", ""), valid_group).upper()
        changed = True
    for k in ("name", "email", "group"):
        st.setdefault(k, "")
    st.setdefault("created_at", now_iso())
    st["schema"] = SCHEMA
    if changed:
        st["updated_at"] = now_iso()
    sp = PDIR / "student.json"
    if changed or not sp.exists():
        sp.write_text(json.dumps(st, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    apply_identity(st)

    if new_repo:
        git_retry("add", "-A")
        git_retry("commit", "-q", "--allow-empty", "-m", "pclp: init")
        print("pclp: ~/work a fost inițializat (git).")
    elif changed:
        snap(msg="pclp: identitate actualizată", quiet=True)
    if st.get("name"):
        print(f"Student: {st['name']} <{st['email']}>, grupa {st['group']}")
    elif a.auto:
        print("pclp: identitatea studentului nu e completată încă (rulează `pclp init`).")


