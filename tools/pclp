def course_config() -> dict:
    for p in (CONTENT / "course.json", Path("/opt/pclp/content/course.json")):
        try:
            return json.loads(p.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
    return {}


def current_week() -> int | None:
    start = course_config().get("semester_start")
    if not start:
        return None
    try:
        d0 = date.fromisoformat(str(start)[:10])
    except ValueError:
        return None
    w = (date.today() - d0).days // 7 + 1
    return max(1, min(14, w))


def cmd_week(a):
    w = current_week()
    if w is None:
        print("Data de început a semestrului nu este configurată (course.json: semester_start).",
              file=sys.stderr)
        if sys.stdin.isatty():
            v = input("În ce săptămână suntem (1-14)? ").strip()
            if v.isdigit() and 1 <= int(v) <= 14:
                print(int(v))
                return
        sys.exit(1)
    print(w)


