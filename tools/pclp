def cmd_update(a):
    info = pclp_content.active_info()
    print(f"Materiale active: versiunea {info['version']} ({info['source']}).")
    if not pclp_content.manifest_url():
        print("Actualizarea automată e dezactivată (PCLP_CONTENT_URL nu e setat).")
        return
    try:
        res = pclp_content.check() if a.check else pclp_content.update()
    except Exception as e:  # noqa: BLE001
        die(f"Nu am putut verifica actualizările: {e}")
    st = res["status"]
    if st == "la-zi":
        print("Ai deja cea mai nouă versiune.")
    elif st == "nou":
        print(f"Există versiunea {res['manifest']['version']}. Rulează `pclp update` ca s-o descarci.")
    elif st == "actualizat":
        print(f"Am actualizat materialele la versiunea {res['version']}. Portalul o folosește imediat.")
    elif st == "imagine-veche":
        print("Materialele noi au nevoie de o versiune mai nouă a mediului. Pe calculatorul tău, în directorul "
              "cu compose.yaml, rulează:  docker compose pull && docker compose up -d")
    else:
        die(f"Actualizarea a eșuat: {res.get('error', st)}")


def main(argv=None):
    p = argparse.ArgumentParser(prog="pclp", description="Mediul de lucru PCLP")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("init", help="inițializează ~/work și datele studentului")
    s.add_argument("--auto", action="store_true", help="fără întrebări (folosit la prima pornire)")
    s.add_argument("--name")
    s.add_argument("--email")
    s.add_argument("--group")
    s.set_defaults(fn=cmd_init)
    s = sub.add_parser("status", help="stare și statistici")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("snap", help="salvează un snapshot acum")
    s.add_argument("-m", "--message")
    s.add_argument("--auto", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_snap)
    s = sub.add_parser("submit", help="creează arhiva de predare pentru o săptămână")
    s.add_argument("week", type=int)
    s.set_defaults(fn=cmd_submit)
    s = sub.add_parser("week", help="săptămâna curentă a semestrului")
    s.set_defaults(fn=cmd_week)
    s = sub.add_parser("test", help="compilează și rulează testele unei probleme")
    s.add_argument("problem", nargs="?", help="id-ul problemei (implicit: directorul curent)")
    s.add_argument("--json", action="store_true", help="rezultat JSON (pentru portal)")
    s.add_argument("--valgrind", action="store_true", help="rulează testele sub valgrind")
    s.set_defaults(fn=cmd_test)
    s = sub.add_parser("ai-install", help="instalează un asistent AI în linie de comandă")
    s.add_argument("tool", choices=sorted(AI_PACKAGES))
    s.set_defaults(fn=cmd_ai_install)
    s = sub.add_parser("update", help="verifică și descarcă materialele noi ale cursului")
    s.add_argument("--check", action="store_true", help="doar verifică, fără descărcare")
    s.set_defaults(fn=cmd_update)
    s = sub.add_parser("ai-changed", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_ai_changed)
    a = p.parse_args(argv)
    try:
        a.fn(a)
    except RuntimeError as e:
        die(str(e))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
