def ai_source_base(src: dict) -> Path:
    env = os.environ.get(src["env"])
    if env:
        return Path(env) / src["env_suffix"] if src["env_suffix"] else Path(env)
    return Path(os.path.expanduser(src["base"]))


def ai_candidates():
    """(tool, fișier sursă, cale relativă) pentru fiecare transcriere de copiat."""
    for src in L.AI_SOURCES:
        base = ai_source_base(src)
        if not base.is_dir():
            continue
        seen = set()
        for pat in src["include"]:
            for f in glob.glob(str(base / pat)):
                p = Path(f)
                if p in seen or not p.is_file() or p.is_symlink():
                    continue
                seen.add(p)
                rel = p.relative_to(base)
                if any(L.SECRET_NAME_RE.search(part) for part in rel.parts):
                    continue
                yield src["tool"], p, rel
        # indexul Continue (sessions.json) are datele sesiunilor — fără secrete
        if src["tool"] == "continue" and (base / "sessions" / "sessions.json").is_file():
            pass  # deja inclus de sessions/*.json


def ai_changed() -> bool:
    stamp = STATE / "ai-sync.stamp"
    t0 = stamp.stat().st_mtime if stamp.exists() else 0
    return any(p.stat().st_mtime > t0 for _, p, _ in ai_candidates())


def ai_sync() -> int:
    """Copiază transcrierile noi/modificate în .pclp/ai/<tool>/. Întoarce numărul de fișiere copiate."""
    n = 0
    skipped = []
    stamp = STATE / "ai-sync.stamp"
    start = time.time()
    for tool, p, rel in ai_candidates():
        try:
            size = p.stat().st_size
            if size > MAX_AI_FILE:
                skipped.append(f"{tool}/{rel} ({size} B)")
                continue
            data = p.read_bytes()
        except OSError:
            continue
        try:
            data = L.redact(data.decode("utf-8")).encode("utf-8")
        except UnicodeDecodeError:
            continue  # nu e text: nu e transcriere
        dst = AIDIR / tool / rel
        try:
            if dst.exists() and dst.read_bytes() == data:
                continue
        except OSError:
            pass
        dst.parent.mkdir(parents=True, exist_ok=True)
        tmp = dst.with_name(dst.name + ".tmp-pclp")
        tmp.write_bytes(data)
        os.replace(tmp, dst)
        n += 1
    if skipped:
        (AIDIR / "_prea_mari.txt").write_text("\n".join(skipped) + "\n", encoding="utf-8")
    STATE.mkdir(parents=True, exist_ok=True)
    stamp.touch()
    os.utime(stamp, (start, start))
    return n


