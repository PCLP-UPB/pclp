def sha256_bytes(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def verification_code(hexdigest: str) -> str:
    x = hexdigest[:16].upper()
    return "PCLP-" + "-".join(x[i:i + 4] for i in range(0, 16, 4))


def git_blob(rel: str) -> bytes:
    r = subprocess.run(["git", "-C", str(WORK), "show", f"HEAD:{rel}"], capture_output=True)
    return r.stdout if r.returncode == 0 else b""


def cmd_submit(a):
    ensure_repo()
    week = a.week
    if not 1 <= week <= 14:
        die("săptămâna trebuie să fie între 1 și 14")
    st = load_student()
    if not st.get("name") or not st.get("email"):
        if sys.stdin.isatty():
            print("Înainte de predare trebuie să îți completezi datele.")
            cmd_init(argparse.Namespace(auto=False, name=None, email=None, group=None))
            st = load_student()
        else:
            die("identitatea nu e completată; rulează `pclp init`")
    wd = f"sapt-{week:02d}"
    tag = wd
    if not (WORK / wd).is_dir():
        print(f"Atenție: directorul {wd}/ nu există în ~/work — arhiva va conține doar istoricul și jurnalele.")

    existing = tags()
    resub = 0
    if week in existing:
        m = re.search(r'"resubmission":\s*(\d+)', git("tag", "-l", "--format=%(contents)", tag).stdout)
        resub = (int(m.group(1)) if m else 0) + 1
    created = now_iso()

    # jurnal de predări (în git, înainte de snapshot-ul final)
    with open(PDIR / "submissions.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps({"week": week, "created_at": created, "resubmission": resub,
                            "pclp_version": VERSION}, ensure_ascii=False) + "\n")
    snap(msg=f"pclp: predare {wd}" + (f" (re-predare {resub})" if resub else ""), quiet=True)
    head = git("rev-parse", "HEAD").stdout.strip()
    prev = prev_tag_for(week)
    prev_head = git("rev-list", "-n1", prev, "--").stdout.strip() if prev else None
    since_time = commit_time(prev) if prev else None
    tag_msg = json.dumps({"week": week, "resubmission": resub, "created_at": created})
    git_retry("tag", "-f", "-a", tag, "-m", tag_msg, head)

    stats = window_stats(prev, since_time)

    # --- conținutul arhivei ---
    entries: dict[str, bytes] = {}
    bundle_path = STATE / "history.bundle"
    git("bundle", "create", "-q", str(bundle_path), "--all")
    entries["history.bundle"] = bundle_path.read_bytes()
    bundle_path.unlink()
    for rel in filter(None, git("ls-files", "-z", "--", wd).stdout.split("\0")):
        entries["files/" + rel[len(wd) + 1:]] = git_blob(rel)
    entries["logs/terminal.log"] = git_blob(".pclp/terminal.log")
    entries["logs/tools.log"] = git_blob(".pclp/tools.log")
    entries["logs/tests.log"] = git_blob(".pclp/tests.log")
    for rel in filter(None, git("ls-files", "-z", "--", ".pclp/ai").stdout.split("\0")):
        entries["ai/" + rel[len(".pclp/ai/"):]] = git_blob(rel)

    manifest = {
        "schema": SCHEMA,
        "kind": "pclp-submission",
        "student": {k: st.get(k, "") for k in ("name", "email", "group")},
        "week": week,
        "tag": tag,
        "head": head,
        "prev_tag": prev.replace("refs/tags/", "") if prev else None,
        "prev_head": prev_head,
        "window_start": since_time.isoformat() if since_time else None,
        "created_at": created,
        "resubmission": resub,
        "pclp_version": VERSION,
        "counts": stats,
        "files": {k: sha256_bytes(v) for k, v in sorted(entries.items())},
    }
    entries["manifest.json"] = (json.dumps(manifest, ensure_ascii=False, indent=2) + "\n").encode("utf-8")

    outdir = WORK / "predari"
    outdir.mkdir(exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M")
    name = f"{wd}-{slugify(st.get('name', ''))}-{stamp}.tar.gz"
    out = outdir / name
    mtime = int(time.time())
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w", format=tarfile.PAX_FORMAT) as tf:
        root = name[:-len(".tar.gz")]
        for arc in sorted(entries):
            data = entries[arc]
            ti = tarfile.TarInfo(f"{root}/{arc}")
            ti.size = len(data)
            ti.mtime = mtime
            ti.mode = 0o644
            ti.uid = ti.gid = 0
            ti.uname = ti.gname = "pclp"
            tf.addfile(ti, io.BytesIO(data))
    with open(out, "wb") as raw, gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=mtime) as gz:
        gz.write(buf.getvalue())
    digest = sha256_file(out)
    code = verification_code(digest)
    (out.parent / (out.name + ".sha256")).write_text(f"{digest}  {out.name}\n{code}\n", encoding="utf-8")

    ai = ", ".join(f"{k}: {v}" for k, v in stats["ai_prompts"].items()) or "0"
    bar = "=" * 70
    print(f"""
{bar}
 Predarea pentru săptămâna {week} este gata{' (re-predare #' + str(resub) + ')' if resub else ''}.

 Arhiva:  {host_path(out)}
          (pe calculatorul tău: în directorul `work/predari/` de lângă compose.yaml)

 COD DE VERIFICARE:   {code}
 SHA-256 complet:     {digest}

 Pași pe Moodle (tema „Săptămâna {week}”):
   1. Încarcă fișierul {name}
   2. Lipește codul {code} în câmpul de text al predării.
 NU modifica arhiva după ce ai generat codul (codul nu ar mai corespunde).

 Rezumat: {stats['commits_window']} snapshot-uri, {stats['commands']} comenzi, {stats['compiles']} compilări
          ({stats['failed_compiles']} eșuate), prompturi AI: {ai}
{bar}""")


