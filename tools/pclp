def exclude_large_staged():
    r = git("diff", "--cached", "--name-only", "--diff-filter=AM", "-z")
    big = []
    for rel in filter(None, r.stdout.split("\0")):
        p = WORK / rel
        try:
            size = p.stat().st_size
        except OSError:
            continue
        limit = MAX_AI_FILE if rel.startswith(".pclp/ai/") else MAX_FILE
        if size > limit:
            big.append(rel)
    if big:
        git_retry("rm", "--cached", "-q", "--", *big)
        excl = WORK / ".git" / "info" / "exclude"
        excl.parent.mkdir(parents=True, exist_ok=True)
        with open(excl, "a", encoding="utf-8") as f:
            for rel in big:
                f.write("/" + rel.replace("\\", "\\\\") + "\n")
    return big


def snap(msg: str | None = None, quiet=False) -> str | None:
    """Întoarce hash-ul commit-ului creat sau None dacă nu era nimic nou."""
    ensure_repo()
    with Lock("snap.lock"):
        st = load_student()
        if st:
            apply_identity(st)
        try:
            ai_sync()
        except Exception as e:  # noqa: BLE001
            print(f"pclp: colectarea sesiunilor AI a eșuat: {e}", file=sys.stderr)
        git_retry("add", "-A")
        big = exclude_large_staged()
        if big and not quiet:
            print("pclp: fișiere > 1 MB excluse din istoric: " + ", ".join(big), file=sys.stderr)
        if git("diff", "--cached", "--quiet", check=False).returncode == 0:
            return None
        git_retry("commit", "-q", "--no-verify", "-m", msg or f"auto: {now_iso()}")
        h = git("rev-parse", "HEAD").stdout.strip()
        if not quiet:
            print(f"snapshot {h[:10]} — {msg or 'auto'}")
        return h


def cmd_snap(a):
    if a.auto and not (WORK / ".git").is_dir():
        return
    h = snap(a.message, quiet=a.auto)
    if not h and not a.auto:
        print("Nimic nou de salvat.")


def cmd_ai_changed(a):
    sys.exit(0 if ai_changed() else 1)


