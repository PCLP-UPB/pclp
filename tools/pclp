# statistici pe fereastra săptămânii
# ---------------------------------------------------------------------------
def tags() -> dict[int, str]:
    out = {}
    for t in git("tag", "-l", "sapt-*").stdout.split():
        m = re.fullmatch(r"sapt-(\d\d)", t)
        if m:
            out[int(m.group(1))] = t
    return out


def prev_tag_for(week: int) -> str | None:
    """Referința completă (refs/tags/sapt-NN) a ultimei predări anterioare săptămânii `week`."""
    tg = tags()
    prev = [w for w in tg if w < week]
    return "refs/tags/" + tg[max(prev)] if prev else None


def commit_time(rev: str) -> datetime:
    return datetime.fromtimestamp(int(git("log", "-1", "--format=%ct", rev, "--").stdout.strip()), tz=timezone.utc)


def head_file(rel: str) -> str:
    r = git("show", f"HEAD:{rel}", check=False)
    return r.stdout if r.returncode == 0 else ""


def window_stats(since_rev: str | None, since_time: datetime | None) -> dict:
    rng = f"{since_rev}..HEAD" if since_rev else "HEAD"
    commits = int(git("rev-list", "--count", rng, "--").stdout.strip() or 0)

    def in_win(ts):
        return since_time is None or ts is None or ts >= since_time

    cmds = [c for c in L.parse_terminal_log(head_file(".pclp/terminal.log")) if in_win(c["ts"])]
    blocks = [b for b in L.parse_tools_log(head_file(".pclp/tools.log")) if in_win(b["ts"])]
    compiles = [b for b in blocks if b["is_compile"]]
    test_runs = [t for t in L.parse_tests_log(head_file(".pclp/tests.log")) if in_win(t["ts"])]
    ai_counts: dict[str, int] = {}
    files = git("ls-files", "-z", "--", ".pclp/ai").stdout.split("\0")
    for rel in filter(None, files):
        text = head_file(rel)
        for m in L.parse_ai_file(rel, text):
            if m["role"] == "user" and in_win(m["ts"]):
                ai_counts[m["tool"]] = ai_counts.get(m["tool"], 0) + 1
    problems = set()
    base = since_rev or "4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # arborele gol
    diff = git("diff", "--name-only", base, "HEAD", "--", check=False)
    for rel in diff.stdout.split():
        m = re.match(r"(sapt-\d\d/[^/]+)/", rel)
        if m:
            problems.add(m.group(1))
    return {
        "commits_window": commits,
        "commits_total": int(git("rev-list", "--count", "HEAD").stdout.strip()),
        "commands": len(cmds),
        "failed_commands": sum(1 for c in cmds if c["exit"] not in (0, None)),
        "compiles": len(compiles),
        "failed_compiles": sum(1 for b in compiles if b["exit"] != 0),
        "valgrind_runs": sum(1 for b in blocks if b["tool"] == "valgrind"),
        "test_runs": len(test_runs),
        "test_runs_all_passed": sum(1 for t in test_runs if t["total"] and t["passed"] == t["total"]),
        "ai_prompts": dict(sorted(ai_counts.items())),
        "problems": sorted(problems),
    }


