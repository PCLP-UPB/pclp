def now_iso() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg: str, code: int = 1):
    print(f"pclp: {msg}", file=sys.stderr)
    sys.exit(code)


def git(*args, check=True, capture=True, env=None, input=None) -> subprocess.CompletedProcess:
    cmd = ["git", "-C", str(WORK), "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null", *args]
    e = dict(os.environ)
    e["PCLP_NO_LOG"] = "1"
    if env:
        e.update(env)
    r = subprocess.run(cmd, capture_output=capture, text=True, env=e, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {(r.stderr or '').strip()}")
    return r


def git_retry(*args, tries=10, **kw):
    """Rulează git cu reîncercare dacă index.lock e ocupat (ex. VS Code rulează git în paralel)."""
    lock = WORK / ".git" / "index.lock"
    last = None
    for i in range(tries):
        try:
            return git(*args, **kw)
        except RuntimeError as e:
            last = e
            if "index.lock" not in str(e):
                raise
            try:
                if lock.exists() and time.time() - lock.stat().st_mtime > 120:
                    lock.unlink()  # rămas de la un proces mort
            except OSError:
                pass
            time.sleep(0.5 + i * 0.5)
    raise last


def load_student() -> dict:
    try:
        return json.loads((PDIR / "student.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def slugify(s: str) -> str:
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode()
    s = re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower()
    return s or "student"


def host_path(p: Path) -> str:
    try:
        return "work/" + str(p.relative_to(WORK))
    except ValueError:
        return str(p)


class Lock:
    def __init__(self, name):
        STATE.mkdir(parents=True, exist_ok=True)
        self.f = open(STATE / name, "w")

    def __enter__(self):
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def ensure_repo():
    if not (WORK / ".git").is_dir():
        die("~/work nu este inițializat. Rulează: pclp init")


