def process(s: Sub, workdir: Path, all_history: bool, gap: int):
    s.sha256 = sha256_file(s.archive)
    check_code(s)
    try:
        extract(s, workdir)
    except (tarfile.TarError, OSError, EOFError, ValueError) as e:
        s.flag("error", "arhiva nu poate fi citită: " + " ".join(str(e).split())[:200])
        s.fatal = True
        return
    check_manifest(s)
    if s.fatal:
        return
    check_bundle(s)
    if s.fatal:
        return
    commits = git_commits(s)
    check_history(s, commits)
    evs, since = build_events(s, commits, all_history)
    s.events = evs
    s._since = since  # type: ignore[attr-defined]
    s.stats = compute_stats(s, evs, sessions_of(evs, gap))


def main(argv=None):
    ap = argparse.ArgumentParser(prog="pclp-verify", description="Verifică predările PCLP și generează cronologii.")
    ap.add_argument("inputs", nargs="+", help="arhive, directoare sau .zip Moodle")
    ap.add_argument("--out", default="pclp-report", help="directorul raportului (implicit ./pclp-report)")
    ap.add_argument("--codes", help="CSV cu coloanele archive,code")
    ap.add_argument("--all-history", action="store_true", help="cronologia include tot istoricul, nu doar săptămâna")
    ap.add_argument("--gap", type=int, default=15, help="pauza (minute) care separă sesiunile (implicit 15)")
    ap.add_argument("--keep-temp", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    if shutil.which("git") is None:
        sys.exit("pclp-verify: este nevoie de git în PATH")
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    workdir = Path(tempfile.mkdtemp(prefix="pclp-verify-"))
    try:
        subs = discover(a.inputs, a.codes, workdir)
        if not subs:
            sys.exit("pclp-verify: nu am găsit nicio arhivă .tar.gz")
        for s in subs:
            try:
                process(s, workdir, a.all_history, a.gap)
            except Exception as e:  # noqa: BLE001 — un student nu trebuie să blocheze raportul
                s.flag("error", f"eroare internă la procesare: {e}")
                s.fatal = True
                traceback.print_exc()
        cross_check(subs)
        used = set()
        for s in subs:
            if s.fatal or not s.stats:
                continue
            st = s.manifest.get("student") or {}
            base = f"timeline-{slug(st.get('name') or s.moodle_name)}-sapt-{s.week:02d}"
            name, i = base + ".html", 2
            while name in used:
                name, i = f"{base}-{i}.html", i + 1
            used.add(name)
            s.timeline_name = name
            (out / name).write_text(render_timeline(s, s.events, s._since, a.gap), encoding="utf-8")
        (out / "index.html").write_text(render_index(subs), encoding="utf-8")
        with open(out / "summary.csv", "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["student", "email", "grupa", "saptamana", "arhiva", "sha256", "cod", "verificare_ok",
                        "erori", "atentionari", "timp_activ_min", "sesiuni", "snapshoturi", "comenzi",
                        "compilari", "compilari_esuate", "valgrind", "rulari_teste", "prompturi_ai",
                        "prompturi_ai_detaliat", "probleme", "timeline"])
            for s in subs:
                st = s.manifest.get("student") or {}
                x = s.stats or {}
                w.writerow([st.get("name") or s.moodle_name, st.get("email", ""), st.get("group", ""), s.week,
                            s.archive.name, s.sha256, s.code or "", "da" if s.ok else "NU",
                            " | ".join(f.msg for f in s.flags if f.sev == "error"),
                            " | ".join(f.msg for f in s.flags if f.sev == "warn"),
                            int(x["active"].total_seconds() // 60) if x else "", x.get("sessions", ""),
                            x.get("snapshots", ""), x.get("commands", ""), x.get("compiles", ""),
                            x.get("failed_compiles", ""), x.get("valgrind", ""), x.get("tests", ""),
                            x.get("ai_total", ""), json.dumps(x.get("ai", {}), ensure_ascii=False),
                            " ".join(x.get("problems", [])), s.timeline_name])
        n_ok = sum(1 for s in subs if s.ok)
        print(f"{len(subs)} arhive procesate: {n_ok} OK, {len(subs) - n_ok} cu erori. Raport: {out / 'index.html'}")
        for s in subs:
            mark = "OK " if s.ok else "ERR"
            print(f"  [{mark}] {s.archive.name}" + "".join(
                f"\n        - {f.sev}: {f.msg}" for f in s.flags if f.sev != "info"))
        return 0 if n_ok == len(subs) else 2
    finally:
        if not a.keep_temp:
            shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
