KIND_LABEL = {"commit": "snapshot", "cmd": "comandă", "tool": "compilare", "test": "teste",
              "ai": "prompt AI", "portal": "AI portal", "external": "AI extern"}
TOOL_LABEL = {"continue": "Continue (VS Code)", "gemini": "Gemini CLI", "claude": "Claude Code",
              "codex": "Codex CLI", "portal": "Portal", "external": "Extern (auto-raportat)"}
E = html.escape


def fmt_td(td: timedelta) -> str:
    m = int(td.total_seconds() // 60)
    return f"{m // 60} h {m % 60:02d} min" if m >= 60 else f"{m} min"


def page(title: str, body: str) -> str:
    return (f"<!doctype html><html lang=\"ro\"><head><meta charset=\"utf-8\">"
            f"<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
            f"<title>{E(title)}</title><style>{CSS}</style></head><body><main>{body}</main></body></html>")


def render_diff(diff: str) -> str:
    out = []
    for ln in diff.splitlines()[:1500]:
        cls = ""
        if ln.startswith(("diff --git", "index ", "new file", "deleted file")):
            continue
        if ln.startswith(("+++", "---")):
            cls = "f"
        elif ln.startswith("@@"):
            cls = "h"
        elif ln.startswith("+"):
            cls = "a"
        elif ln.startswith("-"):
            cls = "d"
        out.append(f'<span class="{cls}">{E(ln) or " "}</span>' if cls else E(ln) + "\n")
    return '<pre class="diff">' + "".join(out) + "</pre>"


def render_output(text: str) -> str:
    out = []
    for ln in text.splitlines():
        if re.search(r"\berror\b|eroare|ERROR SUMMARY: [1-9]|definitely lost: [1-9]|Invalid (read|write)|"
                     r"uninitialised|Segmentation fault", ln):
            out.append(f'<span class="e">{E(ln)}</span>')
        elif re.search(r"\bwarning\b", ln):
            out.append(f'<span class="w">{E(ln)}</span>')
        else:
            out.append(E(ln))
    return '<pre class="out">' + "\n".join(out) + "</pre>"


def render_event(e: Ev, tz) -> str:
    t = e.ts.astimezone(tz).strftime("%H:%M:%S") if e.ts else "—"
    if e.approx:
        t = "≈" + t[:5]
    d = e.data
    k = e.kind
    cls = f"k-{'ai' if k in ('ai', 'portal', 'external') else k}"
    label = KIND_LABEL[k]
    if k == "commit":
        files = ", ".join(f"{st} {E(p)}" for st, p in d["changed"][:12])
        if len(d["changed"]) > 12:
            files += f" … (+{len(d['changed']) - 12})"
        body = f"<div><b>{E(d['subject'])}</b> <span class=muted><code>{d['hash'][:10]}</code></span></div>"
        if files:
            body += f'<div class="files">{files}</div>'
        if d["diff"].strip():
            nl = d["diff"].count("\n")
            body += f"<details><summary>diff .c/.h ({nl} linii)</summary>{render_diff(d['diff'])}</details>"
    elif k == "cmd":
        ec = d["exit"]
        badge = "" if ec in (0, None) else f' <span class="badge b-err">exit {ec}</span>'
        body = f'<code class="cmd">{E(d["cmd"])}</code>{badge} <span class="muted files">{E(d["cwd"])}</span>'
    elif k == "tool":
        bad = d["exit"] != 0 or d.get("has_error")
        if bad:
            cls += " bad"
        label = {"valgrind": "valgrind", "make": "make"}.get(d["tool"], "compilare")
        stt = (f'<span class="badge b-err">exit {d["exit"]}</span>' if d["exit"] != 0 else
               '' if bad else '<span class="badge b-ok">OK</span>')
        if d.get("has_warning") and d["exit"] == 0:
            stt += ' <span class="badge b-warn">avertismente</span>'
        if d["tool"] == "valgrind" and d.get("valgrind_errors"):
            stt += f' <span class="badge b-err">{d["valgrind_errors"]} erori memorie</span>'
        if d["tool"] == "valgrind" and d.get("valgrind_leak"):
            stt += f' <span class="badge b-err">leak {d["valgrind_leak"]} B</span>'
        body = f'<code class="cmd">{E(d["cmd"])}</code> {stt}'
        if d["output"].strip():
            n = d["output"].count("\n") + 1
            op = " open" if bad and n <= 40 else ""
            body += f"<details{op}><summary>ieșire ({n} linii)</summary>{render_output(d['output'])}</details>"
    elif k == "test":
        ok = d["total"] and d["passed"] == d["total"]
        if not ok:
            cls += " bad"
        comp = "" if d["compiled"] else ' <span class="badge b-err">nu compilează</span>'
        mode = " (valgrind)" if d["mode"] == "valgrind" else ""
        body = (f'<b>{E(d["problem"])}</b>: <span class="badge {"b-ok" if ok else "b-warn"}">'
                f'{d["passed"]}/{d["total"]} teste</span>{mode}{comp}')
    else:
        p = d["prompt"]
        tool = TOOL_LABEL.get(p["tool"], p["tool"])
        extra = ""
        if p.get("title"):
            extra += f' — „{E(p["title"])}”'
        if p.get("context"):
            extra += f' — {E(str(p["context"]))}'
        if p.get("tool_name"):
            extra += f' — unealta: {E(p["tool_name"])}'
        body = f'<div class="muted files">{E(tool)}{extra}{" · timp aproximativ (din snapshot)" if e.approx else ""}</div>'
        body += f'<div class="prompt">{E(p["text"][:8000])}</div>'
        if d["replies"]:
            rep = "".join(f'<div class="reply">{E(r["text"][:12000])}</div>' for r in d["replies"][:20])
            body += f"<details><summary>răspuns ({len(d['replies'])} mesaje)</summary>{rep}</details>"
    return (f'<div class="ev"><div class="t">{t}</div><div class="kind {cls}">{E(label)}</div>'
            f'<div class="body">{body}</div></div>')


def flags_html(s: Sub) -> str:
    if not s.flags:
        return '<p><span class="badge b-ok">verificare OK</span> fără observații</p>'
    items = []
    for f in sorted(s.flags, key=lambda f: SEV_ORDER[f.sev]):
        b = {"error": ("b-err", "EROARE"), "warn": ("b-warn", "atenție"), "info": ("b-info", "info")}[f.sev]
        items.append(f'<li><span class="badge {b[0]}">{b[1]}</span> {E(f.msg)}</li>')
    head = ('<span class="badge b-ok">integritate OK</span>' if s.ok else
            '<span class="badge b-err">verificare EȘUATĂ</span>')
    return f'<p>{head}</p><ul class="flags">{"".join(items)}</ul>'


def render_timeline(s: Sub, evs: list[Ev], since, gap: int) -> str:
    st = s.manifest.get("student") or {}
    created = L.parse_ts(s.manifest.get("created_at"))
    tz = created.tzinfo if created else timezone.utc
    sess = sessions_of(evs, gap)
    x = s.stats
    ai = ", ".join(f"{TOOL_LABEL.get(k, k)}: {v}" for k, v in sorted(x["ai"].items())) or "0"
    body = [f"<h1>{E(st.get('name') or s.moodle_name or '?')} — săptămâna {s.week}</h1>",
            f"<div class=muted>{E(st.get('email', ''))} · grupa {E(st.get('group', ''))} · "
            f"predat {E(created.astimezone(tz).strftime('%Y-%m-%d %H:%M') if created else '?')} · "
            f"arhiva <code>{E(s.archive.name)}</code> · imagine {E(str(s.manifest.get('pclp_version', '?')))}</div>",
            "<h2>Verificare</h2>", f'<div class="card">{flags_html(s)}'
            f'<div class="muted files">SHA-256: <code>{s.sha256}</code> · cod: {E(s.code or "—")} '
            f'({E(s.code_source or "—")})</div></div>',
            "<h2>Rezumat</h2><div class=\"grid\">"]
    for val, lab in ((fmt_td(x["active"]), "timp activ estimat"), (x["sessions"], "sesiuni de lucru"),
                     (x["snapshots"], "snapshot-uri cu cod"), (x["commands"], "comenzi în terminal"),
                     (x["compiles"], "compilări"), (x["failed_compiles"], "compilări eșuate"),
                     (x["valgrind"], "rulări valgrind"), (x["tests"], "rulări de teste"),
                     (x["ai_total"], "prompturi AI")):
        body.append(f'<div class="card stat"><b>{E(str(val))}</b><span>{E(lab)}</span></div>')
    body.append("</div>")
    body.append(f'<p class="muted">Prompturi AI: {E(ai)}. Probleme: {E(", ".join(x["problems"]) or "—")}. '
                f'Fereastra: {"de la predarea anterioară (" + E(since.astimezone(tz).strftime("%Y-%m-%d %H:%M")) + ")" if since else "tot istoricul"}. '
                f'Timpul activ = suma intervalelor dintre evenimente consecutive mai mici de {gap} minute.</p>')
    body.append("<h2>Cronologie</h2>")
    if not sess:
        body.append("<p class=muted>Niciun eveniment în fereastra acestei predări.</p>")
    for i, ss in enumerate(sess, 1):
        a, b = ss[0].ts.astimezone(tz), ss[-1].ts.astimezone(tz)
        kinds = {}
        for e in ss:
            kinds[KIND_LABEL[e.kind]] = kinds.get(KIND_LABEL[e.kind], 0) + 1
        summ = ", ".join(f"{v} {k}" for k, v in kinds.items())
        body.append(f'<div class="session">Sesiunea {i}: {a.strftime("%a %Y-%m-%d")} '
                    f'{a.strftime("%H:%M")}–{b.strftime("%H:%M")} ({fmt_td(b - a)}) '
                    f'<span class="muted" style="font-weight:400">· {E(summ)}</span></div>')
        body.extend(render_event(e, tz) for e in ss)
    undated = [e for e in evs if not e.ts]
    if undated:
        body.append('<div class="session">Fără dată</div>')
        body.extend(render_event(e, tz) for e in undated)
    body.append(f'<p class="muted" style="margin-top:40px">Generat de pclp-verify la '
                f'{datetime.now().strftime("%Y-%m-%d %H:%M")}. <a href="index.html">← înapoi la listă</a></p>')
    return page(f"{st.get('name', '?')} — săpt. {s.week}", "".join(body))


def render_index(subs: list[Sub]) -> str:
    rows = []
    for s in sorted(subs, key=lambda s: ((s.manifest.get("student") or {}).get("group", ""),
                                         (s.manifest.get("student") or {}).get("name", s.moodle_name), s.week)):
        st = s.manifest.get("student") or {}
        x = s.stats or {}
        nerr = sum(1 for f in s.flags if f.sev == "error")
        nwarn = sum(1 for f in s.flags if f.sev == "warn")
        ver = ('<span class="badge b-ok">OK</span>' if s.ok else f'<span class="badge b-err">{nerr} erori</span>')
        if nwarn:
            ver += f' <span class="badge b-warn">{nwarn} atenționări</span>'
        name = E(st.get("name") or s.moodle_name or s.archive.name)
        link = f'<a href="{E(s.timeline_name)}">{name}</a>' if s.timeline_name else name
        tip = E("; ".join(f.msg for f in s.flags if f.sev != "info"))
        rows.append(
            f"<tr><td>{link}<div class='muted files'>{E(st.get('email', ''))}</div></td><td>{E(st.get('group', ''))}</td>"
            f"<td class=n>{s.week or '?'}</td><td title=\"{tip}\">{ver}</td>"
            f"<td class=n>{fmt_td(x['active']) if x else '—'}</td><td class=n>{x.get('snapshots', '—')}</td>"
            f"<td class=n>{x.get('commands', '—')}</td><td class=n>{x.get('compiles', '—')}</td>"
            f"<td class=n>{x.get('failed_compiles', '—')}</td><td class=n>{x.get('ai_total', '—')}</td>"
            f"<td class=n>{x.get('tests', '—')}</td><td>{E(', '.join(x.get('problems', [])))}</td></tr>")
    body = ("<h1>Predări PCLP — raport de verificare</h1>"
            f"<p class=muted>{len(subs)} arhive · generat {datetime.now().strftime('%Y-%m-%d %H:%M')} · "
            "treceți cu mouse-ul peste coloana „Verificare” pentru detalii; fișierul summary.csv conține aceleași date.</p>"
            "<div class=tablewrap><table><thead><tr><th>Student</th><th>Grupa</th><th>Săpt.</th><th>Verificare</th>"
            "<th>Timp activ</th><th>Snapshot-uri</th><th>Comenzi</th><th>Compilări</th><th>Eșuate</th>"
            "<th>Prompturi AI</th><th>Teste</th><th>Probleme</th></tr></thead><tbody>"
            + "".join(rows) + "</tbody></table></div>"
            "<p class=muted>Limite: codul de verificare dovedește doar că arhiva nu a fost modificată după ce a "
            "fost generată; nu dovedește autenticitatea istoricului (vezi docs/teacher.md).</p>")
    return page("Predări PCLP", body)


