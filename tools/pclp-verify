#!/usr/bin/env python3
"""pclp-verify — verificarea predărilor PCLP și generarea cronologiei procesului (partea profesorului).

Utilizare:
  pclp-verify [opțiuni] <arhivă.tar.gz | director | moodle.zip> ... --out raport/

Intrări acceptate:
  * arhive individuale sapt-NN-*.tar.gz
  * un director (ex. dezarhivarea „Descarcă toate predările” din Moodle); se caută recursiv arhivele.
    Codul de verificare se ia din `onlinetext.html` (în același folder sau în folderul
    `<Nume>_<id>_assignsubmission_onlinetext_` al aceluiași student).
  * un .zip Moodle (se dezarhivează temporar)
  * --codes coduri.csv cu coloanele archive,code (numele fișierului arhivei și codul lipit)

Rezultat: <out>/index.html, <out>/summary.csv, <out>/timeline-<student>-sapt-NN.html

Cerințe: Python 3.10+, git în PATH. Doar biblioteca standard.
"""
from __future__ import annotations

import argparse
import csv
import hashlib
import html
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import traceback
import unicodedata
import zipfile
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pclp_logs as L  # noqa: E402

CODE_RE = re.compile(r"PCLP(?:[-\s]?[0-9A-Fa-f]{4}){4}")
HEX64_RE = re.compile(r"\b[0-9a-fA-F]{64}\b")
MOODLE_DIR_RE = re.compile(r"^(?P<name>.+?)_(?P<id>\d+)_assignsubmission_(?P<kind>[a-z]+)_?$")
MAX_TOTAL = 800 * 1024 * 1024
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
SEV_ORDER = {"error": 0, "warn": 1, "info": 2}


# ---------------------------------------------------------------------------
# modele
# ---------------------------------------------------------------------------
@dataclass
class Flag:
    sev: str   # error | warn | info
    msg: str


@dataclass
class Sub:
    archive: Path
    code: str | None = None
    code_source: str = ""
    moodle_name: str = ""
    moodle_id: str = ""
    sha256: str = ""
    flags: list[Flag] = field(default_factory=list)
    manifest: dict = field(default_factory=dict)
    tmp: Path | None = None
    root: Path | None = None
    repo: Path | None = None
    head: str = ""
    week: int = 0
    stats: dict = field(default_factory=dict)
    events: list = field(default_factory=list)
    timeline_name: str = ""
    fatal: bool = False

    def flag(self, sev, msg):
        self.flags.append(Flag(sev, msg))

    @property
    def ok(self):
        return not any(f.sev == "error" for f in self.flags)

    @property
    def student_key(self):
        st = self.manifest.get("student") or {}
        return (st.get("email") or "").strip().lower() or slug(st.get("name") or self.moodle_name or self.archive.name)


def slug(s: str) -> str:
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode()
    return re.sub(r"[^A-Za-z0-9]+", "-", s).strip("-").lower() or "student"


def name_tokens(s: str) -> set[str]:
    return {t for t in slug(s).split("-") if len(t) > 1}


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run_git(repo: Path, *args, check=False, text=True) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo), "-c", "core.quotepath=false", *args],
                          capture_output=True, text=text, check=check)


# ---------------------------------------------------------------------------
# descoperirea arhivelor și a codurilor
# ---------------------------------------------------------------------------
def html_to_text(s: str) -> str:
    s = re.sub(r"<[^>]+>", " ", s)
    return html.unescape(s)


def find_code(text: str) -> str | None:
    m = CODE_RE.search(text)
    if m:
        return m.group(0)
    m = HEX64_RE.search(text)
    return m.group(0) if m else None


def safe_unzip(zp: Path, dest: Path):
    with zipfile.ZipFile(zp) as z:
        for info in z.infolist():
            n = info.filename
            if n.startswith("/") or ".." in Path(n).parts:
                continue
            z.extract(info, dest)


def discover(inputs: list[str], codes_csv: str | None, workdir: Path) -> list[Sub]:
    csv_codes: dict[str, str] = {}
    if codes_csv:
        with open(codes_csv, newline="", encoding="utf-8-sig") as f:
            for row in csv.reader(f):
                if len(row) >= 2 and row[0].strip().lower() != "archive":
                    csv_codes[Path(row[0].strip()).name] = row[1].strip()
    archives: list[Path] = []
    for inp in inputs:
        p = Path(inp)
        if p.is_file() and p.suffix.lower() == ".zip":
            d = workdir / ("zip-" + slug(p.stem))
            d.mkdir(parents=True, exist_ok=True)
            safe_unzip(p, d)
            p = d
        if p.is_dir():
            for dp, dns, fns in os.walk(p):
                dns.sort()
                for fn in sorted(fns):
                    if fn.endswith((".tar.gz", ".tgz")):
                        archives.append(Path(dp) / fn)
        elif p.is_file():
            archives.append(p)
        else:
            print(f"pclp-verify: nu găsesc {inp}", file=sys.stderr)
    subs = []
    for a in archives:
        s = Sub(archive=a)
        m = MOODLE_DIR_RE.match(a.parent.name)
        if m:
            s.moodle_name, s.moodle_id = m.group("name"), m.group("id")
        if a.name in csv_codes:
            s.code, s.code_source = csv_codes[a.name], "CSV"
        else:
            cands = [a.parent / "onlinetext.html"]
            if m:
                prefix = f"{m.group('name')}_{m.group('id')}_"
                cands += sorted(a.parent.parent.glob(prefix + "*onlinetext*/onlinetext.html"))
                cands += sorted(a.parent.parent.glob(prefix + "*onlinetext*/*.html"))
            for c in cands:
                if c.is_file():
                    code = find_code(html_to_text(c.read_text(encoding="utf-8", errors="replace")))
                    if code:
                        s.code, s.code_source = code, "Moodle (onlinetext)"
                        break
        subs.append(s)
    return subs


# ---------------------------------------------------------------------------
# verificarea unei arhive
# ---------------------------------------------------------------------------
def check_code(s: Sub):
    if not s.code:
        s.flag("warn", "codul de verificare lipsește (nu a fost găsit în textul predării / CSV)")
        return
    c = s.code.upper().replace("PCLP", "")
    c = re.sub(r"[^0-9A-F]", "", c)
    if len(c) == 64:
        ok = c == s.sha256.upper()
    elif len(c) >= 16:
        ok = s.sha256.upper().startswith(c)
    else:
        s.flag("error", f"cod de verificare invalid: {s.code!r}")
        return
    if not ok:
        s.flag("error", f"codul de verificare NU corespunde arhivei (cod {s.code}, arhivă "
                        f"PCLP-{'-'.join(s.sha256[i:i + 4].upper() for i in range(0, 16, 4))}) — "
                        "arhiva a fost modificată după generare sau codul e greșit")


def extract(s: Sub, workdir: Path):
    s.tmp = Path(tempfile.mkdtemp(prefix="arh-", dir=workdir))
    total = 0
    with tarfile.open(s.archive, "r:*") as tf:
        roots = set()
        for mem in tf.getmembers():
            parts = Path(mem.name).parts
            if not parts or mem.name.startswith("/") or ".." in parts:
                s.flag("error", f"membru suspect în arhivă: {mem.name!r}")
                continue
            if not (mem.isfile() or mem.isdir()):
                s.flag("warn", f"membru ignorat (nu e fișier): {mem.name!r}")
                continue
            roots.add(parts[0])
            if mem.isdir():
                continue
            total += mem.size
            if total > MAX_TOTAL:
                raise ValueError("arhivă prea mare")
            dst = s.tmp / Path(*parts)
            dst.parent.mkdir(parents=True, exist_ok=True)
            f = tf.extractfile(mem)
            with open(dst, "wb") as out:
                shutil.copyfileobj(f, out)
    mans = sorted(s.tmp.glob("manifest.json")) + sorted(s.tmp.glob("*/manifest.json"))
    s.root = mans[0].parent if mans else s.tmp
    if len(roots) > 1:
        s.flag("warn", "arhiva are mai multe intrări la rădăcină: " + ", ".join(sorted(roots)[:5]))


def check_manifest(s: Sub):
    mp = s.root / "manifest.json"
    if not mp.is_file():
        s.flag("error", "manifest.json lipsește")
        s.fatal = True
        return
    try:
        s.manifest = json.loads(mp.read_text(encoding="utf-8"))
    except ValueError as e:
        s.flag("error", f"manifest.json invalid: {e}")
        s.fatal = True
        return
    s.week = int(s.manifest.get("week") or 0)
    s.head = s.manifest.get("head") or ""
    files = s.manifest.get("files") or {}
    present = {str(p.relative_to(s.root)).replace(os.sep, "/") for p in s.root.rglob("*") if p.is_file()}
    present.discard("manifest.json")
    bad, missing = [], []
    for rel, h in files.items():
        p = s.root / rel
        if not p.is_file():
            missing.append(rel)
        elif sha256_file(p) != h:
            bad.append(rel)
    extra = sorted(present - set(files))
    if bad:
        s.flag("error", "fișiere modificate față de manifest: " + ", ".join(bad[:10]))
    if missing:
        s.flag("error", "fișiere lipsă față de manifest: " + ", ".join(missing[:10]))
    if extra:
        s.flag("warn", "fișiere în plus, nelistate în manifest: " + ", ".join(extra[:10]))
    if s.manifest.get("kind") != "pclp-submission":
        s.flag("warn", "manifest de tip necunoscut")
    if s.moodle_name:
        mn = (s.manifest.get("student") or {}).get("name", "")
        if mn and not (name_tokens(mn) & name_tokens(s.moodle_name)):
            s.flag("warn", f"numele din arhivă ({mn}) diferă de cel din Moodle ({s.moodle_name})")
    if s.manifest.get("resubmission"):
        s.flag("info", f"re-predare #{s.manifest['resubmission']}")


def check_bundle(s: Sub):
    b = s.root / "history.bundle"
    if not b.is_file():
        s.flag("error", "history.bundle lipsește")
        s.fatal = True
        return
    s.repo = s.tmp / "repo.git"
    run_git(s.tmp, "init", "-q", "--bare", str(s.repo))
    v = run_git(s.repo, "bundle", "verify", str(b))
    if v.returncode != 0:
        s.flag("error", "git bundle verify a eșuat: " + (v.stderr or v.stdout).strip()[:300])
        s.fatal = True
        return
    f = run_git(s.repo, "fetch", "-q", str(b), "+refs/*:refs/*")
    if f.returncode != 0:
        s.flag("error", "nu pot importa istoricul: " + f.stderr.strip()[:300])
        s.fatal = True
        return
    if not s.head or run_git(s.repo, "cat-file", "-e", f"{s.head}^{{commit}}").returncode != 0:
        s.flag("error", f"commit-ul HEAD din manifest ({s.head[:12]}) nu există în istoric")
        s.fatal = True
        return
    tag = s.manifest.get("tag") or f"sapt-{s.week:02d}"
    t = run_git(s.repo, "rev-parse", "-q", "--verify", f"refs/tags/{tag}^{{commit}}")
    if t.returncode != 0:
        s.flag("warn", f"tag-ul {tag} lipsește din istoric")
    elif t.stdout.strip() != s.head:
        s.flag("error", f"tag-ul {tag} nu indică spre HEAD-ul din manifest")
    main = run_git(s.repo, "rev-parse", "-q", "--verify", "refs/heads/main").stdout.strip()
    if main and main != s.head:
        s.flag("info", "ramura main conține commit-uri după predare (nu afectează verificarea)")


def git_commits(s: Sub) -> list[dict]:
    fmt = "%H%x1f%P%x1f%at%x1f%ct%x1f%an%x1f%ae%x1f%s"
    r = run_git(s.repo, "log", "--topo-order", "--reverse", f"--format={fmt}", s.head, "--")
    out = []
    for line in r.stdout.splitlines():
        p = line.split("\x1f")
        if len(p) < 7:
            continue
        out.append({"hash": p[0], "parents": p[1].split(), "at": int(p[2]), "ct": int(p[3]),
                    "an": p[4], "ae": p[5], "subject": p[6]})
    return out


def check_history(s: Sub, commits: list[dict]):
    created = L.parse_ts(s.manifest.get("created_at"))
    by_hash = {c["hash"]: c for c in commits}
    if not commits:
        s.flag("error", "istoric gol")
        return
    if commits[0]["subject"] != "pclp: init":
        s.flag("warn", f"primul commit nu este „pclp: init” ({commits[0]['subject'][:60]!r})")
    backwards, amended, future, merges = [], [], [], 0
    for c in commits:
        if len(c["parents"]) > 1:
            merges += 1
        for ph in c["parents"]:
            pc = by_hash.get(ph)
            if pc and c["ct"] < pc["ct"] - 300:
                backwards.append(c)
        if abs(c["at"] - c["ct"]) > 120:
            amended.append(c)
        if created and c["ct"] > created.timestamp() + 600:
            future.append(c)
    if backwards:
        s.flag("warn", f"{len(backwards)} commit-uri cu dată anterioară părintelui (ceas modificat sau "
                       f"istorie rescrisă), ex. {backwards[0]['hash'][:10]}")
    if amended:
        s.flag("warn", f"{len(amended)} commit-uri cu data autorului ≠ data commit-ului (rebase/amend/"
                       f"cherry-pick?), ex. {amended[0]['hash'][:10]} „{amended[0]['subject'][:40]}”")
    if future:
        s.flag("warn", f"{len(future)} commit-uri datate după momentul predării")
    if merges:
        s.flag("info", f"{merges} commit-uri de tip merge")
    # tag-urile săptămânilor anterioare trebuie să fie strămoși ai HEAD
    for t in run_git(s.repo, "tag", "-l", "sapt-*").stdout.split():
        m = re.fullmatch(r"sapt-(\d\d)", t)
        if not m or int(m.group(1)) >= s.week:
            continue
        if run_git(s.repo, "merge-base", "--is-ancestor", f"refs/tags/{t}^{{commit}}", s.head).returncode != 0:
            s.flag("error", f"predarea anterioară {t} nu este strămoș al acestei predări (istorie rescrisă)")
    ph = s.manifest.get("prev_head")
    if ph and run_git(s.repo, "merge-base", "--is-ancestor", ph, s.head).returncode != 0:
        s.flag("error", "prev_head din manifest nu este strămoș al HEAD")
    # identitate
    email = ((s.manifest.get("student") or {}).get("email") or "").lower()
    others = {c["ae"].lower() for c in commits} - {email, "student@pclp.invalid", ""}
    if email and others:
        s.flag("warn", "commit-uri cu alte adrese de email: " + ", ".join(sorted(others)[:5]))
    # jurnale din arhivă == cele din git
    for arc, rel in (("logs/terminal.log", ".pclp/terminal.log"), ("logs/tools.log", ".pclp/tools.log"),
                     ("logs/tests.log", ".pclp/tests.log")):
        p = s.root / arc
        if not p.is_file():
            if arc != "logs/tests.log":
                s.flag("warn", f"{arc} lipsește")
            continue
        g = run_git(s.repo, "show", f"{s.head}:{rel}", text=False)
        if g.returncode == 0 and g.stdout != p.read_bytes():
            s.flag("error", f"{arc} diferă de versiunea din istoricul git")
    # files/ == arborele git sapt-NN/
    wd = f"sapt-{s.week:02d}"
    fdir = s.root / "files"
    if fdir.is_dir():
        for p in fdir.rglob("*"):
            if p.is_file():
                rel = str(p.relative_to(fdir)).replace(os.sep, "/")
                g = run_git(s.repo, "show", f"{s.head}:{wd}/{rel}", text=False)
                if g.returncode != 0 or g.stdout != p.read_bytes():
                    s.flag("error", f"files/{rel} diferă de versiunea din istoricul git")
                    break


def cross_check(subs: list[Sub]):
    by_student: dict[str, list[Sub]] = {}
    for s in subs:
        if s.repo and not s.fatal:
            by_student.setdefault(s.student_key, []).append(s)
    for key, lst in by_student.items():
        lst.sort(key=lambda x: (x.week, x.manifest.get("created_at") or ""))
        for i, cur in enumerate(lst):
            for prev in lst[:i]:
                if prev.week == cur.week:
                    cur.flag("info", f"există și o predare anterioară pentru aceeași săptămână ({prev.archive.name})")
                    if run_git(cur.repo, "cat-file", "-e", f"{prev.head}^{{commit}}").returncode != 0 or \
                            run_git(cur.repo, "merge-base", "--is-ancestor", prev.head, cur.head).returncode != 0:
                        cur.flag("error", f"predarea anterioară {prev.archive.name} nu e strămoș (istorie rescrisă)")
                    continue
                if run_git(cur.repo, "cat-file", "-e", f"{prev.head}^{{commit}}").returncode != 0:
                    cur.flag("error", f"HEAD-ul predării din săpt. {prev.week} ({prev.head[:10]}) lipsește din "
                                      "istoric — istoria a fost rescrisă sau repo-ul a fost reinițializat")
                elif run_git(cur.repo, "merge-base", "--is-ancestor", prev.head, cur.head).returncode != 0:
                    cur.flag("error", f"predarea din săpt. {prev.week} nu este strămoș al acestei predări")
                else:
                    cur.flag("info", f"verificat lanțul cu predarea din săpt. {prev.week}")


# ---------------------------------------------------------------------------
# evenimente pentru cronologie
# ---------------------------------------------------------------------------
@dataclass
class Ev:
    ts: datetime | None
    kind: str        # commit | cmd | tool | test | ai | external | portal
    data: dict
    approx: bool = False


def ai_messages(s: Sub, since: datetime | None) -> list[dict]:
    """Citește ai/** din arhivă; mesajele fără timestamp primesc momentul commit-ului care le-a adus."""
    aidir = s.root / "ai"
    msgs: list[dict] = []
    if not aidir.is_dir():
        return msgs
    cont_index = {}
    ip = aidir / "continue" / "sessions" / "sessions.json"
    if ip.is_file():
        cont_index = L.continue_index(ip.read_text(encoding="utf-8", errors="replace"))
    for p in sorted(aidir.rglob("*")):
        if not p.is_file():
            continue
        rel = "ai/" + str(p.relative_to(aidir)).replace(os.sep, "/")
        text = p.read_text(encoding="utf-8", errors="replace")
        ms = L.parse_ai_file(rel, text)
        if not ms:
            continue
        if any(m["ts"] is None for m in ms):
            assign_git_times(s, ".pclp/" + rel, ms)
        if ms and ms[0]["tool"] == "continue":
            sid = ms[0]["session"]
            if sid in cont_index:
                d, title = cont_index[sid]
                for m in ms:
                    m.setdefault("title", title)
        msgs.extend(ms)
    return msgs


def assign_git_times(s: Sub, gitpath: str, ms: list[dict]):
    r = run_git(s.repo, "log", "--reverse", "--format=%H %ct", s.head, "--", gitpath)
    prev_n = 0
    for line in r.stdout.splitlines():
        h, ct = line.split()
        blob = run_git(s.repo, "show", f"{h}:{gitpath}")
        if blob.returncode != 0:
            continue
        n = len(L.parse_ai_file(gitpath.replace(".pclp/", "", 1), blob.stdout))
        t = datetime.fromtimestamp(int(ct), tz=timezone.utc)
        for m in ms[prev_n:n]:
            if m["ts"] is None:
                m["ts"] = t
                m["approx"] = True
        prev_n = max(prev_n, n)


def build_events(s: Sub, commits: list[dict], all_history: bool) -> tuple[list[Ev], datetime | None]:
    since = None
    prev_tag = s.manifest.get("prev_tag")
    if prev_tag and not all_history:
        r = run_git(s.repo, "log", "-1", "--format=%ct", f"refs/tags/{prev_tag}^{{commit}}", "--")
        if r.returncode == 0 and r.stdout.strip():
            since = datetime.fromtimestamp(int(r.stdout.strip()), tz=timezone.utc)
    evs: list[Ev] = []

    def keep(ts):
        return since is None or ts is None or ts > since

    prev_commit_set = set()
    if since and prev_tag:
        prev_commit_set = set(run_git(s.repo, "rev-list", f"refs/tags/{prev_tag}^{{commit}}", "--").stdout.split())
    for c in commits:
        if c["hash"] in prev_commit_set:
            continue
        ts = datetime.fromtimestamp(c["ct"], tz=timezone.utc)
        parent = c["parents"][0] if c["parents"] else EMPTY_TREE
        names = run_git(s.repo, "diff", "--name-status", "--no-renames", parent, c["hash"]).stdout.splitlines()
        changed = [ln.split("\t", 1) for ln in names if "\t" in ln]
        visible = [x for x in changed if not x[1].startswith(".pclp/")]
        if not visible and c["subject"].startswith("auto:"):
            continue  # doar jurnale -> apar ca evenimente proprii
        diff = run_git(s.repo, "diff", "--no-color", "-U3", parent, c["hash"], "--",
                       "*.c", "*.h", "*Makefile", "*makefile").stdout
        evs.append(Ev(ts, "commit", {**c, "changed": visible, "diff": diff}))
    for c in L.parse_terminal_log(read(s.root / "logs/terminal.log")):
        if keep(c["ts"]):
            evs.append(Ev(c["ts"], "cmd", c))
    for b in L.parse_tools_log(read(s.root / "logs/tools.log")):
        if keep(b["ts"]):
            evs.append(Ev(b["ts"], "tool", b))
    for t in L.parse_tests_log(read(s.root / "logs/tests.log")):
        if keep(t["ts"]):
            evs.append(Ev(t["ts"], "test", t))
    # AI: grupăm prompt + răspunsuri
    msgs = ai_messages(s, since)
    by_file: dict[str, list[dict]] = {}
    for m in msgs:
        by_file.setdefault(m["file"] + "|" + str(m.get("session")), []).append(m)
    for key, ms in by_file.items():
        cur = None
        for m in ms:
            if m["role"] == "user":
                cur = {"prompt": m, "replies": []}
                if keep(m["ts"]):
                    kind = "external" if m["tool"] == "external" else ("portal" if m["tool"] == "portal" else "ai")
                    evs.append(Ev(m["ts"], kind, cur, approx=bool(m.get("approx"))))
            elif cur is not None:
                cur["replies"].append(m)
    return evs, since


def read(p: Path) -> str:
    try:
        return p.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def sessions_of(evs: list[Ev], gap_min: int) -> list[list[Ev]]:
    dated = sorted((e for e in evs if e.ts), key=lambda e: e.ts)
    out: list[list[Ev]] = []
    for e in dated:
        if out and (e.ts - out[-1][-1].ts) < timedelta(minutes=gap_min):
            out[-1].append(e)
        else:
            out.append([e])
    return out


def compute_stats(s: Sub, evs: list[Ev], sess: list[list[Ev]]) -> dict:
    active = sum(((x[-1].ts - x[0].ts) for x in sess), timedelta())
    tools = [e.data for e in evs if e.kind == "tool"]
    compiles = [b for b in tools if b["is_compile"]]
    ai_by_tool: dict[str, int] = {}
    for e in evs:
        if e.kind in ("ai", "portal", "external"):
            t = e.data["prompt"]["tool"]
            ai_by_tool[t] = ai_by_tool.get(t, 0) + 1
    problems = set()
    for e in evs:
        if e.kind == "commit":
            for _, path in e.data["changed"]:
                m = re.match(r"sapt-\d\d/([^/]+)/", path)
                if m:
                    problems.add(m.group(1))
        elif e.kind == "test":
            problems.add(e.data["problem"])
    snaps = sum(1 for e in evs if e.kind == "commit")
    return {
        "active": active, "sessions": len(sess), "snapshots": snaps,
        "commits_window": (s.manifest.get("counts") or {}).get("commits_window"),
        "commands": sum(1 for e in evs if e.kind == "cmd"),
        "compiles": len(compiles), "failed_compiles": sum(1 for b in compiles if b["exit"] != 0),
        "valgrind": sum(1 for b in tools if b["tool"] == "valgrind"),
        "tests": sum(1 for e in evs if e.kind == "test"),
        "ai": ai_by_tool, "ai_total": sum(ai_by_tool.values()),
        "problems": sorted(problems),
    }


