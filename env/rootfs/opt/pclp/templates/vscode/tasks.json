{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PCLP: compilează fișierul curent",
      "type": "shell",
      "command": "gcc",
      "args": ["-Wall", "-Wextra", "-std=c11", "-g", "-O0", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}", "-lm"],
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "PCLP: rulează cu valgrind",
      "type": "shell",
      "command": "valgrind",
      "args": ["--leak-check=full", "--show-leak-kinds=all", "--track-origins=yes", "${fileDirname}/${fileBasenameNoExtension}"],
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "PCLP: compilează fișierul curent",
      "problemMatcher": []
    },
    {
      "label": "PCLP: make",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
